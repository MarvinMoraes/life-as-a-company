# ── LLM Provider (Claude-only stack) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Provider Selection ──────────────────────────────────────────
# "mock" (sem API, para testes) | "claude"
DEFAULT_PROVIDER=mock

# ── Model routing por papel ─────────────────────────────────────
# Manager orquestra com o modelo mais forte; execução com Sonnet 5;
# agentes mais simples com Haiku 4.5. Ajuste conforme custo/qualidade.
DEFAULT_MODEL=claude-sonnet-5
MODEL_MANAGER=claude-opus-4-8
MODEL_ENGINEER=claude-sonnet-5
MODEL_PRODUCT=claude-sonnet-5
MODEL_QA=claude-haiku-4-5
MODEL_MARKETING=claude-haiku-4-5

# ── Token Governance ────────────────────────────────────────────
MAX_TOKENS_PER_CALL=4096
MAX_CONTEXT_TOKENS=8192
COMPRESSION_THRESHOLD=6000   # compress context above this

# ── Obsidian / Memory ───────────────────────────────────────────
VAULT_PATH=./vault
MEMORY_SNAPSHOTS_ENABLED=true
MEMORY_MAX_NOTES_IN_CONTEXT=5

# ── n8n Integration (future) ────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=rich   # "rich" | "json"

# ── Factory Meta ────────────────────────────────────────────────
FACTORY_NAME=life-as-a-company
